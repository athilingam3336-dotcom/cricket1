{
  "name": "cricnative",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "cors": "^2.8.6",
    "expo": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "express": "^5.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix mobile_frontend run dev",
    "start": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix mobile_frontend start",
    "android": "npm --prefix mobile_frontend run android",
    "ios": "npm --prefix mobile_frontend run ios",
    "web": "npm --prefix mobile_frontend run web"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.2.4",
    "concurrently": "^10.0.5",
    "typescript": "~6.0.3"
  }
}
