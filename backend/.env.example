PORT=5000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cricket_db
DB_USER=root
DB_PASSWORD=
JWT_SECRET=super_secret_cricket_federation_jwt_token_2026
FRONTEND_URL=http://localhost:8081

# Special Development Admin Bypass (Configurable & Isolated)
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_OTP=1234
DEV_ADMIN_BYPASS=true

# Nodemailer / Gmail SMTP Configuration
# In production, set SMTP_USER to your Gmail and SMTP_PASSWORD to your 16-character Google App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Cricket Federation" <no-reply@cfvd.org>
