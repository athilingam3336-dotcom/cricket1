PORT=5000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cricket_db
DB_USER=root
DB_PASSWORD=
JWT_SECRET=super_secret_cricket_federation_jwt_token_2026
FRONTEND_URL=http://localhost:8081

# Special Development Admin Bypass (Configurable & Isolated)
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_OTP=1234
DEV_ADMIN_BYPASS=true

# =======================================================
# Nodemailer / SMTP Configuration for Official OTP Emails
# =======================================================
# For Gmail SMTP:
# 1. Turn ON 2-Step Verification in Google Account.
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App password named "Cricket Scorer".
# 4. Paste your Gmail into SMTP_USER and the 16-character App Password into SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
SMTP_FROM="Cricket Federation of Virudhunagar District" <no-reply@cfvd.org>
