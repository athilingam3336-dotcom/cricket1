{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "*.ts",
    "*.tsx",
    "*.js",
    "App.js",
    "index.js"
  ],
  "exclude": [
    "node_modules",
    "mobile_frontend",
    "backend",
    "cricket1",
    "scripts"
  ]
}
